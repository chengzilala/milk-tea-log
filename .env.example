# 服务端口
PORT=8830

# 豆包（火山方舟，OpenAI 兼容接口）
# 获取：https://console.volcengine.com/ark → API Key 管理；模型需先在「开通管理」开通
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=doubao-seed-2-1-lite-260915
DASHSCOPE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 备用：通义千问 VL（阿里云百炼）；用这家时把上面三行换成这三行的值
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-vl-max-latest
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 高德 Web 服务 Key（逆地理编码）
# 获取：https://console.amap.com/dev/key/app
AMAP_KEY=

# 抠图（Phase 3 贴纸）：remove.bg
# 获取：https://www.remove.bg/api → Dashboard → API Keys → 新建；每月 50 次免费（低分辨率）
# 注意：remove.bg 独立站将于 2026-12-01 停止服务，换供应商时改 CUTOUT_PROVIDER 即可
# 不填则页面自动降级为原图贴纸卡
REMOVEBG_API_KEY=
CUTOUT_PROVIDER=removebg

# 仅本地联调用：没有 Key 时返回假识别结果（1=开启，0=关闭）
MOCK_AI=0

# 线上放在 Caddy / Nginx / 隧道后面时设为 1，让限流拿到真实客户端 IP
TRUST_PROXY=0
